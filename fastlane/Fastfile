default_platform(:android)

# ── Replace these with your app's values ──────────────────────────────────────
APP_NAME        = "YOUR_APP_NAME"          # matches ~/.secrets/<APP_NAME>/
BUNDLE_ID_DEV   = "com.yourcompany.yourapp.dev"
BUNDLE_ID_STAGE = "com.yourcompany.yourapp.staging"
BUNDLE_ID_PROD  = "com.yourcompany.yourapp"
# ──────────────────────────────────────────────────────────────────────────────

PROJECT_ROOT = File.expand_path("..", __dir__)
PUBSPEC_PATH = File.join(PROJECT_ROOT, "pubspec.yaml")
SECRETS_DIR  = File.expand_path("~/.secrets/#{APP_NAME}")
FLUTTER      = ENV["CI"] ? "flutter" : "fvm flutter"

# ── Version helpers ────────────────────────────────────────────────────────────

def semantic_version
  m = File.read(PUBSPEC_PATH).match(/^version:\s+(\d+\.\d+\.\d+)/)
  raise "Cannot parse semantic version from pubspec.yaml" unless m
  m[1]
end

def build_number_path(env)
  File.join(PROJECT_ROOT, "build_numbers", env)
end

def read_build_number(env)
  path = build_number_path(env)
  File.exist?(path) ? File.read(path).strip.to_i : 0
end

def bump_build_number(env)
  new_code = read_build_number(env) + 1
  File.write(build_number_path(env), new_code.to_s)
  new_code
end

# ── Android ────────────────────────────────────────────────────────────────────

platform :android do
  desc "Deploy dev to Play Store internal track"
  lane :deploy_dev do
    version  = semantic_version
    build_no = bump_build_number("dev")
    tag      = "#{version}+#{build_no}"

    UI.message("Building #{tag} (android dev)")

    sh("cp '#{SECRETS_DIR}/dev/google-services.json' '#{PROJECT_ROOT}/android/app/google-services.json'")

    sh(
      "#{FLUTTER} build appbundle --release" \
      " --dart-define-from-file='#{SECRETS_DIR}/dev.json'" \
      " --target=lib/main_dev.dart" \
      " --build-number=#{build_no}" \
      " --build-name=#{version}"
    )

    upload_to_play_store(
      track:                   "internal",
      aab:                     "#{PROJECT_ROOT}/build/app/outputs/bundle/release/app-release.aab",
      json_key:                "#{SECRETS_DIR}/google-play-service-account.json",
      package_name:            BUNDLE_ID_DEV,
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_changelogs:  true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
    )

    git_commit(
      path:    build_number_path("dev"),
      message: "chore: release android dev #{tag}",
    )

    UI.success("✓ #{tag} deployed to Play Store internal track")
  end

  desc "Deploy staging to Play Store internal track"
  lane :deploy_staging do
    version  = semantic_version
    build_no = bump_build_number("staging")
    tag      = "#{version}+#{build_no}"

    UI.message("Building #{tag} (android staging)")

    sh("cp '#{SECRETS_DIR}/staging/google-services.json' '#{PROJECT_ROOT}/android/app/google-services.json'")

    sh(
      "#{FLUTTER} build appbundle --release" \
      " --dart-define-from-file='#{SECRETS_DIR}/staging.json'" \
      " --target=lib/main_staging.dart" \
      " --build-number=#{build_no}" \
      " --build-name=#{version}"
    )

    upload_to_play_store(
      track:                   "internal",
      aab:                     "#{PROJECT_ROOT}/build/app/outputs/bundle/release/app-release.aab",
      json_key:                "#{SECRETS_DIR}/google-play-service-account.json",
      package_name:            BUNDLE_ID_STAGE,
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_changelogs:  true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
    )

    git_commit(
      path:    build_number_path("staging"),
      message: "chore: release android staging #{tag}",
    )

    UI.success("✓ #{tag} deployed to Play Store internal track (staging)")
  end

  desc "Deploy prod to Play Store production track"
  lane :deploy_prod do
    version  = semantic_version
    build_no = bump_build_number("prod")
    tag      = "#{version}+#{build_no}"

    UI.message("Building #{tag} (android prod)")

    sh("cp '#{SECRETS_DIR}/prod/google-services.json' '#{PROJECT_ROOT}/android/app/google-services.json'")

    sh(
      "#{FLUTTER} build appbundle --release" \
      " --dart-define-from-file='#{SECRETS_DIR}/prod.json'" \
      " --target=lib/main_prod.dart" \
      " --build-number=#{build_no}" \
      " --build-name=#{version}"
    )

    upload_to_play_store(
      track:                   "production",
      aab:                     "#{PROJECT_ROOT}/build/app/outputs/bundle/release/app-release.aab",
      json_key:                "#{SECRETS_DIR}/google-play-service-account.json",
      package_name:            BUNDLE_ID_PROD,
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_changelogs:  true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
    )

    git_commit(
      path:    build_number_path("prod"),
      message: "chore: release android prod #{tag}",
    )

    UI.success("✓ #{tag} deployed to Play Store production track")
  end
end
