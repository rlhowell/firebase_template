# Copy to .env.<YOUR_FIREBASE_PROJECT_ID> (one file per environment) and fill in.
# These are read by Firebase Functions v2 params at deploy time.
# Deploy: firebase deploy --only functions --project <alias>

# Cloud Functions region (e.g. us-central1, europe-west2, asia-east1)
FUNCTIONS_REGION=europe-west2

# Hostname only — no https:// prefix (e.g. myapp.web.app or links.myapp.com)
DEEP_LINK_HOST=YOUR_PROJECT_ID.web.app

# Custom URL scheme registered in AndroidManifest + Info.plist (lowercase, no underscores)
CUSTOM_SCHEME=yourapp

# App Store numeric ID (e.g. 1234567890) — shown on store fallback page
APP_STORE_ID=

# Play Store package name (matches prod applicationId)
PLAY_STORE_PACKAGE=com.yourcompany.yourapp

# iOS: Apple Developer Team ID (10-char string from developer.apple.com)
APPLE_TEAM_ID=XXXXXXXXXX

# iOS: prod bundle ID — used in apple-app-site-association
IOS_BUNDLE_ID=com.yourcompany.yourapp

# Android: prod package name — used in assetlinks.json
ANDROID_PACKAGE=com.yourcompany.yourapp

# Android: SHA-256 cert fingerprint of your release keystore (colon-separated hex)
# Run: keytool -list -v -keystore release.jks | grep "SHA256:"
ANDROID_SHA256_CERT=AA:BB:CC:...
