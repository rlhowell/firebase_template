rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // True when the request comes from a verified Firebase Auth user.
    function isSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in user's UID matches the given uid.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when the incoming write only touches the listed fields
    // (prevents clients from adding unexpected fields).
    function onlyUpdates(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Deny everything by default ──────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }

    // ── User profiles ───────────────────────────────────────────────────────

    match /users/{uid} {
      // Users can read and update their own profile.
      allow read: if isOwner(uid);

      // Create is handled server-side (Cloud Function or backend).
      // Remove this rule and add a Cloud Function trigger if you want to
      // prevent clients from writing directly.
      allow create: if isOwner(uid);

      // Clients may only update whitelisted mutable fields.
      allow update: if isOwner(uid)
          && onlyUpdates(['displayName', 'photoUrl', 'updatedAt']);

      allow delete: if false;
    }

    // ── Add your own collections below ──────────────────────────────────────

    // Example: a global read-only catalogue managed from the backend.
    // match /products/{productId} {
    //   allow read: if isSignedIn();
    //   allow write: if false;
    // }

    // Example: per-user orders (users own their own documents).
    // match /orders/{orderId} {
    //   allow read, create: if isSignedIn()
    //       && request.resource.data.userId == request.auth.uid;
    //   allow update: if isOwner(resource.data.userId)
    //       && onlyUpdates(['status', 'updatedAt']);
    //   allow delete: if false;
    // }
  }
}
